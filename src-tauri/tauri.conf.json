{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boonsh",
  "version": "0.10.4",
  "identifier": "com.boonsh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "boonsh",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$HOME/.aws/**",
            "$HOME/.azure/**",
            "$HOME/.kube/**",
            "$HOME/.docker/**",
            "$APPDATA/Microsoft/Credentials/**",
            "$APPDATA/Microsoft/Protect/**",
            "$LOCALAPPDATA/Google/Chrome/User Data/**",
            "$LOCALAPPDATA/Microsoft/Edge/User Data/**",
            "$LOCALAPPDATA/BraveSoftware/Brave-Browser/User Data/**",
            "$APPDATA/Mozilla/Firefox/Profiles/**",
            "$APPDATA/com.boonsh.app/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "Copyright (c) 2026 Somboon L.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": ["THIRD_PARTY_LICENSES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QjQwQ0YxRUNCNDM1NTkKUldSWk5iVHM4UXkwZEhkL1VueVBaRnZuaGQ1UGx1RERUZlBPbVNuZm0rUXJ6YVRFdmNmeXZ3N00K",
      "endpoints": ["https://github.com/ssaelao-wq/boonsh/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
